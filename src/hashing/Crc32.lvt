namespace Livt.Utils.Hashing

/**
 * CRC32 checksum (IEEE 802.3 / zlib, reflected polynomial 0xEDB88320).
 *
 * Usage:
 *   1. Reset()                          — initialise accumulator to 0xFFFFFFFF
 *   2. ProcessBlock(blk)  × 0..n        — feed full 16-byte blocks
 *   3. ProcessFinalBlock(blk, len)       — feed last 0..16 bytes; applies final XOR
 *   4. GetCrc() / GetByte(idx)           — read 4-byte result, little-endian
 *
 * Output byte order: little-endian.
 *   GetByte(0) = LSB of the CRC32 value.
 *   GetByte(3) = MSB of the CRC32 value.
 *
 * Example: CRC32("123456789") = 0xCBF43926
 *   GetByte(0) = 0x26, GetByte(1) = 0x39, GetByte(2) = 0xF4, GetByte(3) = 0xCB
 */
component Crc32
{
    crc: byte[4]

    /**
     * Initialises the accumulator to 0xFFFFFFFF.
     */
    new()
    {
        crc[0] = 0xFF
        crc[1] = 0xFF
        crc[2] = 0xFF
        crc[3] = 0xFF
    }

    public const BLOCK_SIZE: int = 16

    /**
     * Initialise the accumulator to 0xFFFFFFFF, starting a new computation.
     */
    public fn Reset()
    {
        state {
            crc[0] = 0xFF
            crc[1] = 0xFF
            crc[2] = 0xFF
            crc[3] = 0xFF
        }
    }

    /**
     * Feed a full 16-byte block into the accumulator.
     * Call zero or more times before ProcessFinalBlock.
     */
    public fn ProcessBlock(blk: byte[16])
    {
        var i: int = 0
        while (i < 16)
        {
            var b:   byte = blk[i]
            var idx: byte = crc[0] ^ b
            var lB0: byte = this.LookupB0(idx)
            var lB1: byte = this.LookupB1(idx)
            var lB2: byte = this.LookupB2(idx)
            var lB3: byte = this.LookupB3(idx)
            state {
                crc[0] = crc[1] ^ lB0
                crc[1] = crc[2] ^ lB1
                crc[2] = crc[3] ^ lB2
                crc[3] =               lB3
            }
            i++
        }
    }

    /**
     * Feed the last partial block and apply the final XOR.
     * After this call, GetCrc() / GetByte() return the final CRC32 value.
     * Pass len = 0 to finalise with no additional data (e.g. empty input).
     *
     * Requires: len in 0..16. Behaviour is undefined for len > 16.
     */
    public fn ProcessFinalBlock(blk: byte[16], len: int)
    {
        var i: int = 0
        while (i < len)
        {
            var b:   byte = blk[i]
            var idx: byte = crc[0] ^ b
            var lB0: byte = this.LookupB0(idx)
            var lB1: byte = this.LookupB1(idx)
            var lB2: byte = this.LookupB2(idx)
            var lB3: byte = this.LookupB3(idx)
            state {
                crc[0] = crc[1] ^ lB0
                crc[1] = crc[2] ^ lB1
                crc[2] = crc[3] ^ lB2
                crc[3] =               lB3
            }
            i++
        }
        // Apply final XOR (0xFFFFFFFF).
        var c0: byte = crc[0]
        var c1: byte = crc[1]
        var c2: byte = crc[2]
        var c3: byte = crc[3]
        state {
            crc[0] = c0 ^ 0xFF
            crc[1] = c1 ^ 0xFF
            crc[2] = c2 ^ 0xFF
            crc[3] = c3 ^ 0xFF
        }
    }

    /**
     * Return the 4-byte CRC32 result in little-endian order.
     * Call only after ProcessFinalBlock.
     */
    public fn GetCrc() byte[4]
    {
        return crc
    }

    /**
     * Return a single byte of the CRC32 result (idx 0 = LSB, 3 = MSB).
     *
     * Requires: idx in 0..3. Out-of-range idx returns crc[3].
     */
    public fn GetByte(idx: int) byte
    {
        if (idx == 0) { return crc[0] }
        if (idx == 1) { return crc[1] }
        if (idx == 2) { return crc[2] }
        return crc[3]
    }

    /**
     * Return byte 0 (LSB) of the CRC32 table entry for the given index.
     */
    fn LookupB0(idx: byte) byte
    {
        var i: int = idx as int
        if (i < 64)
        {
            return TABLE_B0_Q0[i]
        }
        if (i < 128)
        {
            var j1: int = i - 64
            return TABLE_B0_Q1[j1]
        }
        if (i < 192)
        {
            var j2: int = i - 128
            return TABLE_B0_Q2[j2]
        }
        var j3: int = i - 192
        return TABLE_B0_Q3[j3]
    }

    /**
     * Return byte 1 of the CRC32 table entry for the given index.
     */
    fn LookupB1(idx: byte) byte
    {
        var i: int = idx as int
        if (i < 64)
        {
            return TABLE_B1_Q0[i]
        }
        if (i < 128)
        {
            var j1: int = i - 64
            return TABLE_B1_Q1[j1]
        }
        if (i < 192)
        {
            var j2: int = i - 128
            return TABLE_B1_Q2[j2]
        }
        var j3: int = i - 192
        return TABLE_B1_Q3[j3]
    }

    /**
     * Return byte 2 of the CRC32 table entry for the given index.
     */
    fn LookupB2(idx: byte) byte
    {
        var i: int = idx as int
        if (i < 64)
        {
            return TABLE_B2_Q0[i]
        }
        if (i < 128)
        {
            var j1: int = i - 64
            return TABLE_B2_Q1[j1]
        }
        if (i < 192)
        {
            var j2: int = i - 128
            return TABLE_B2_Q2[j2]
        }
        var j3: int = i - 192
        return TABLE_B2_Q3[j3]
    }

    /**
     * Return byte 3 (MSB) of the CRC32 table entry for the given index.
     */
    fn LookupB3(idx: byte) byte
    {
        var i: int = idx as int
        if (i < 64)
        {
            return TABLE_B3_Q0[i]
        }
        if (i < 128)
        {
            var j1: int = i - 64
            return TABLE_B3_Q1[j1]
        }
        if (i < 192)
        {
            var j2: int = i - 128
            return TABLE_B3_Q2[j2]
        }
        var j3: int = i - 192
        return TABLE_B3_Q3[j3]
    }

